# The phones' USB nodes and configuration for LEHU (group plugdev): Apple
# devices, and Android phones once in accessory mode (18d1:2d00/2d01).
# Write access to bConfigurationValue lets wired CarPlay switch the
# iPhone to configuration 6 without root.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", MODE="0660", GROUP="plugdev", RUN+="/bin/chgrp plugdev /sys%p/bConfigurationValue", RUN+="/bin/chmod 0664 /sys%p/bConfigurationValue"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[01]", MODE="0660", GROUP="plugdev"
# An Android phone before the switch: LEHU asks any phone for the
# accessory protocol, so every non-hub device node is readable by it.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{bDeviceClass}!="09", MODE="0660", GROUP="plugdev"
