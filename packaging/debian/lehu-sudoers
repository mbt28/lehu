# What LEHU may do as root: reboot, power off, set the clock from the
# phone's, and restart the access point after its network was changed from
# the screens. Nothing else; LEHU runs as a user in the group lehu.
%lehu ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /usr/bin/date -u -s *, /usr/bin/systemctl restart hostapd
