config BR2_PACKAGE_LEHU
	bool "LEHU"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU # sudo
	depends on !BR2_STATIC_LIBS # dlopen of libdbus
	# the video: ffmpeg's v4l2-request decoder on cedrus
	select BR2_PACKAGE_FFMPEG
	# audio out and in, Opus for CarPlay's voice
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_OPUS
	# Android Auto's TLS, and wired CarPlay's lockdown
	select BR2_PACKAGE_OPENSSL
	# Bluetooth: BlueZ over libdbus (loaded at run time), HID devices
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_BLUEZ5_UTILS
	select BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID
	select BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG
	# the hands-free record phones ask for before wireless Android Auto
	select BR2_PACKAGE_BLUEZ_ALSA
	# reboot, power off, the clock and the access point, from the screens
	select BR2_PACKAGE_SUDO
	help
	  LEHU, a lightweight embedded head unit: wired and wireless
	  CarPlay and Android Auto for small Linux boards, with its own
	  screens in Slint on DRM/KMS and the phone's video on the V4L2
	  stateless decoder.

	  https://github.com/mbt28/lehu

if BR2_PACKAGE_LEHU

config BR2_PACKAGE_LEHU_SERVICE
	bool "start LEHU at boot as user lehu"
	default y
	help
	  Create the unprivileged user lehu and start LEHU as it from
	  the init script S99lehu, with the sudo rule and the D-Bus
	  policy it needs (docs/image-requirements.md in the source).

	  Say no when the image starts LEHU itself, as another user (from
	  a login's profile, say): then only the program, its settings
	  layer and the udev rules for phones are installed, and the
	  user, its groups and permissions are the image's.

endif

comment "LEHU needs a toolchain w/ threads, dynamic library"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
